PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-bucket-name
LIFF_CHANNEL_ID=your-liff-channel-id
LINE_CHANNEL_SECRET=your-line-channel-secret

BEAM_BASE_URL=https://playground.api.beamcheckout.com
BEAM_MERCHANT_ID=your-beam-merchant-id
BEAM_API_KEY=your-beam-api-key
BEAM_WEBHOOK_HMAC_KEY=your-beam-webhook-hmac-key
PAYMENT_REDIRECT_URL=https://your-frontend-domain.com/payment
PAYMENT_WEBHOOK_PUBLIC_URL=https://your-api-domain.com/webhooks/beam
PAYMENT_LINK_EXPIRY_MINUTES=30
PAYMENT_CURRENCY=THB
BEAM_ENABLE_CARD=true
BEAM_ENABLE_CARD_INSTALLMENTS=false
BEAM_ENABLE_QR_PROMPTPAY=true
BEAM_ENABLE_EWALLETS=false
BEAM_ENABLE_MOBILE_BANKING=true
BEAM_ENABLE_BNPL=false

VERTEX_MODEL=gemini-3-pro-image-preview
VERTEX_LOCATION=global
GENAI_PROVIDER=vertex
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_IMAGE_ASPECT_RATIO=1:1
GEMINI_IMAGE_SIZE=2K
GENAI_FALLBACK_PROVIDER=gemini_api
GENAI_FALLBACK_MAX_RETRIES=2
LINE_PROFILE_CACHE_TTL_SECONDS=300
LINE_PROFILE_CACHE_GRACE_SECONDS=600
LINE_PROFILE_REQUEST_TIMEOUT=10.0
LINE_PROFILE_REQUEST_RETRIES=1
LINE_PROFILE_RETRY_DELAY=0.5
GENERATION_CONCURRENCY=1
GENERATION_COOLDOWN_SECONDS=30
GENERATION_MAX_RETRIES=8
GENERATION_RETRY_BASE_DELAY=5.0
